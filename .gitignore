# Lluvia Live - .gitignore

# Dependencias
node_modules/
venv/
.venv/

# Cache de Python
__pycache__/
*.pyc
*.pyo

# Variables de entorno (cada servidor tiene las suyas)
.env
.env.*
!.env.example
firebase-admin.json

# Builds
/build
dist/
frontend/build/

# IDE
.idea/
.vscode/
*.swp
*~

# Sistema
.DS_Store
Thumbs.db
*.pem
*.key

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.pytest_cache/
.ruff_cache/

# Archivos comprimidos
*.zip
*.tar.gz
*.tar
*.tgz
*.pack

# Carpetas de plataforma de desarrollo (NO son parte de Lluvia Live)
.emergent/
.gitconfig

# Credenciales
credentials.json
.credentials
