# Lluvia Live - .gitignore

# Dependencias
node_modules/
venv/
.venv/

# Cache de Python
__pycache__/
*.pyc
*.pyo

# Variables de entorno (cada servidor tiene las suyas)
.env
.env.*
!.env.example

# Builds
/build
dist/
frontend/build/

# IDE
.idea/
.vscode/
*.swp
*~

# Sistema
.DS_Store
Thumbs.db
*.pem
*.key

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.pytest_cache/
.ruff_cache/

# Archivos comprimidos
*.zip
*.tar.gz
*.tar
*.tgz
*.pack
frontend/node_modules/.cache/default-development/41.pack
frontend/node_modules/.cache/default-development/0.pack
frontend/node_modules/.cache/default-development/3.pack
frontend/node_modules/.cache/default-development/6.pack
frontend/node_modules/.cache/default-development/2.pack
frontend/node_modules/.cache/default-development/1.pack
