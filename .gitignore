node_modules/
venv/
.venv/
*.egg-info/

# ─── Caché Python ─────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ─── Variables de entorno y credenciales ──────────────
.env
.env.*
!.env.example
firebase-admin.json
credentials.json
.credentials
*.pem
*.key

# ─── Builds y artefactos ──────────────────────────────
/build
dist/
frontend/build/
*.tar.gz
*.zip
*.tgz
*.pack

# ─── IDE y sistema operativo ──────────────────────────
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# ─── Logs ─────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Testing y reportes internos ──────────────────────
coverage/
.pytest_cache/
.ruff_cache/
test_reports/
memory/

# ─── Caché de plataforma de desarrollo ────────────────
.emergent/
.gitconfig
frontend/node_modules/.cache/
