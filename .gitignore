# Lluvia Live - .gitignore

# Dependencies
node_modules/
venv/
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# Environment (cada servidor tiene el suyo)
.env
.env.*
*.env
.env.bak

# Build outputs
/build
dist/
frontend/build/

# IDE
.idea/
.vscode/
*.swp
*~

# System
.DS_Store
*.pem
*.key

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing/Development
coverage/
.pytest_cache/
.ruff_cache/
test_reports/
test_result.md

# Platform artifacts (NO subir)
.platform/
.gitconfig
memory/
*.pack

# Archives
*.zip
*.tar.gz
*.tar
*.tgz
*.deb

# Mobile cache
android-sdk/
frontend/node_modules/.cache/default-development/41.pack
frontend/node_modules/.cache/default-development/0.pack
